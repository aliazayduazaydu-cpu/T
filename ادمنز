Section(PlayersPage,"PLAYER DETECTION")

local function ClearESP()
    for player,items in pairs(ESPObjects) do
        for _,item in pairs(items) do
            item:Destroy()
        end
    end
    table.clear(ESPObjects)
end

local function AddESP(target)
    if target == Player or ESPObjects[target] then return end

    local character = target.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.fromOffset(90,100)
    billboard.StudsOffset = Vector3.new(0,2,0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = root
    billboard.Parent = PlayerGui

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1,0,1,0)
    box.BackgroundTransparency = 1
    box.Parent = billboard

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255,40,40)
    stroke.Thickness = 2
    stroke.Parent = box

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1,0,0,20)
    name.Position = UDim2.new(0,0,0,-22)
    name.BackgroundTransparency = 1
    name.Text = target.DisplayName
    name.TextColor3 = Color3.new(1,1,1)
    name.TextStrokeTransparency = 0
    name.TextSize = 11
    name.Font = Enum.Font.GothamBold
    name.Parent = billboard

    ESPObjects[target] = {
        highlight,
        billboard,
        name,
        box,
    }
end

local function RefreshESP()
    ClearESP()

    if not Settings.ESP and not Settings.Names then
        return
    end

    for _,target in ipairs(Players:GetPlayers()) do
        if target ~= Player then
            AddESP(target)
        end
    end
end

