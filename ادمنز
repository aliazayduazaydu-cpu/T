local function Button(page,text,callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1,-8,0,38)
    button.BackgroundColor3 = Color3.fromRGB(39,39,45)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(240,240,240)
    button.Font = Enum.Font.Gotham
    button.TextSize = 12
    button.Parent = page

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(65,65,72)
    stroke.Thickness = 1
    stroke.Parent = button

    button.MouseButton1Click:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(.12),
            {BackgroundColor3 = Color3.fromRGB(65,65,75)}
        ):Play()

        callback()
    end)

    return button
end

local function Toggle(page,text,default,callback)
    local enabled = default or false

    local button = Button(
        page,
        text.."  [OFF]",
        function() end
    )

    local function Update()
        button.Text = text.."  ["..
            (enabled and "ON" or "OFF").."]"

        button.BackgroundColor3 = enabled
            and Color3.fromRGB(28,105,65)
            or Color3.fromRGB(39,39,45)
    end

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        Update()
        callback(enabled)
    end)

    Update()
    return button
end

local function Input(page,text,default,callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1,-8,0,38)
    box.BackgroundColor3 = Color3.fromRGB(39,39,45)
    box.TextColor3 = Color3.new(1,1,1)
    box.PlaceholderColor3 = Color3.fromRGB(160,160,160)
    box.PlaceholderText = text
    box.Text = tostring(default)
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.ClearTextOnFocus = false
    box.Parent = page

    box.FocusLost:Connect(function()
        local value = tonumber(box.Text)
        if value then callback(value) end
    end)

    return box
end

