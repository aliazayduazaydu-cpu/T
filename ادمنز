local function RebuildCategories()
	if not UI.CatScroll then return end
	for _, ch in ipairs(UI.CatScroll:GetChildren()) do
		if ch:IsA("TextButton") then ch:Destroy() end
	end
	for _, catName in ipairs(CategoryList) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, 0, 0, 44)
		b.BackgroundColor3 = (State.SelectedCategory == catName) and Theme.Primary or Theme.Card
		b.TextColor3 = (State.SelectedCategory == catName) and Theme.Bg or Theme.Text
		b.Text = catName
		b.Font = Enum.Font.GothamBold
		b.TextSize = 17
		b.Parent = UI.CatScroll
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
		b.MouseButton1Click:Connect(function()
			API.PlaySound("rbxassetid://6895079853", 0.3, 1.2)
			State.SelectedCategory = catName
			RebuildCategories()
			RefreshCommandGrid()
		end)
	end
end

RefreshCommandGrid = function()
	if not UI.CmdScroll then return end
	for _, ch in ipairs(UI.CmdScroll:GetChildren()) do
		if ch:IsA("TextButton") then ch:Destroy() end
	end

	local shown = 0
	for i, cmd in ipairs(Commands) do
		local catMatch = (State.SelectedCategory == "الكل") or (cmd.Category == State.SelectedCategory)
		local q = State.SearchQuery
		local textMatch = (q == "")
			or string.find(string.lower(cmd.Name), q, 1, true)
			or string.find(string.lower(cmd.Display), q, 1, true)
			or string.find(string.lower(cmd.Desc), q, 1, true)

		if catMatch and textMatch then
			shown += 1
			local card = Instance.new("TextButton")
			card.LayoutOrder = i
			card.BackgroundColor3 = Theme.Card
			card.Text = ""
			card.AutoButtonColor = false
			card.Parent = UI.CmdScroll
			Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)

			local stroke = Instance.new("UIStroke")
			stroke.Color = Theme.Primary
			stroke.Transparency = 0.72
			stroke.Thickness = 1.4
			stroke.Parent = card

			local nameLbl = Instance.new("TextLabel")
			nameLbl.Size = UDim2.new(1, -18, 0, 28)
			nameLbl.Position = UDim2.fromOffset(10, 8)
			nameLbl.BackgroundTransparency = 1
			nameLbl.Text = cmd.Display .. "  [" .. cmd.Name .. "]"
			nameLbl.Font = Enum.Font.GothamBold
			nameLbl.TextSize = 16
			nameLbl.TextXAlignment = Enum.TextXAlignment.Left
			nameLbl.TextColor3 = Theme.Text
			nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
			nameLbl.Parent = card

			local descLbl = Instance.new("TextLabel")
			descLbl.Size = UDim2.new(1, -18, 0, 44)
			descLbl.Position = UDim2.fromOffset(10, 38)
			descLbl.BackgroundTransparency = 1
			descLbl.Text = cmd.Desc
			descLbl.Font = Enum.Font.Gotham
			descLbl.TextSize = 14
			descLbl.TextWrapped = true
			descLbl.TextXAlignment = Enum.TextXAlignment.Left
			descLbl.TextYAlignment = Enum.TextYAlignment.Top
			descLbl.TextColor3 = Theme.SubText
			descLbl.Parent = card

			card.MouseEnter:Connect(function()
				card.BackgroundColor3 = Theme.CardHover
				stroke.Transparency = 0.1
			end)
			card.MouseLeave:Connect(function()
				card.BackgroundColor3 = Theme.Card
				stroke.Transparency = 0.72
			end)
			card.MouseButton1Click:Connect(function()
				local arg = UI.ArgBox and UI.ArgBox.Text or ""
				local ok, result = pcall(cmd.Run, arg)
				if ok then
					API.Notify(tostring(result or ("تم تنفيذ: " .. cmd.Display)), false)
				else
					API.Notify("خطأ: " .. tostring(result), true)
				end
			end)
		end
	end

	if UI.CountBadge then
		UI.CountBadge.Text = shown .. " / " .. #Commands .. " أمر"
	end
end

-- مؤثرات نزول وصعود الهولوجرام الـ 3D
local function SpawnLandingBurst(cf: CFrame)
	local fxPart = Instance.new("Part")
	fxPart.Anchored = true
	fxPart.CanCollide = false
	fxPart.Transparency = 1
	fxPart.Size = Vector3.new(1, 1, 1)
	fxPart.CFrame = cf
	fxPart.Parent = Workspace

	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Theme.Primary, Theme.Secondary)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.4, 0.9)
	pe.Speed = NumberRange.new(6, 14)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Rate = 0
	pe.Parent = fxPart
	pe:Emit(35)
	Debris:AddItem(fxPart, 1.5)
end

function API.TogglePanel(forceState: boolean?)
	if forceState ~= nil then
		State.IsOpen = forceState
	else
		State.IsOpen = not State.IsOpen
	end

	if not State.HoloPart then
		Build3DInterface()
		RebuildCategories()
		RefreshCommandGrid()
	end

	local hrp = API.GetHRP()
	if State.IsOpen then
		API.PlaySound("rbxassetid://7035166082", 0.5, 1.05)
		local targetPos = hrp and (hrp.CFrame * CFrame.new(0, State.PanelHeight, -State.PanelDistance)).Position
			or Vector3.new(0, 8, 0)
		local lookAt = hrp and (hrp.Position + Vector3.new(0, 1.5, 0)) or Vector3.new(0, 8, 10)
		local targetCF = CFrame.lookAt(targetPos, lookAt)
		State.AnchorCF = targetCF

		-- بداية النزول من السماء
		State.HoloPart.Parent = Workspace
		State.SurfaceGui.Enabled = true
		State.HoloPart.Size = Vector3.new(2, 0.3, 0.14)
		State.HoloPart.CFrame = targetCF * CFrame.new(0, 15, 0)
		State.SelectionBox.Transparency = 0

		TweenService:Create(
			State.HoloPart,
			TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ CFrame = targetCF, Size = Vector3.new(11.5, 7.4, 0.14) }
		):Play()

		task.delay(0.35, function()
			if State.IsOpen then
				SpawnLandingBurst(targetCF)
			end
		end)
		if UI.LauncherBtn then
			UI.LauncherBtn.Text = "✖ إخفاء القائمة [F2]"
		end
	else
		API.PlaySound("rbxassetid://7035166082", 0.4, 0.75)
		local exitCF = State.AnchorCF * CFrame.new(0, 14, 0)
