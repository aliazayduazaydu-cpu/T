local function CreateTab(name, icon)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1,-8,0,43)
    button.Position = UDim2.fromOffset(4,0)
    button.BackgroundColor3 = Color3.fromRGB(35,35,40)
