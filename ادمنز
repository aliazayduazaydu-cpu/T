local Rainbow = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
    ColorSequenceKeypoint.new(.2, Color3.fromRGB(255,0,255)),
    ColorSequenceKeypoint.new(.4, Color3.fromRGB(0,100,255)),
    ColorSequenceKeypoint.new(.6, Color3.fromRGB(0,255,200)),
    ColorSequenceKeypoint.new(.8, Color3.fromRGB(0,255,0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0))
})

local function AddRGB(parent)
    local gradient = Instance.new("UIGradient")
    gradient.Color = Rainbow
    gradient.Rotation = 0
    gradient.Parent = parent

    local rotation = 0
    local connection

    connection = RunService.RenderStepped:Connect(function(dt)
        if not parent.Parent then
            connection:Disconnect()
            return
        end

        rotation = (rotation + dt * 85) % 360
        gradient.Rotation = rotation
    end)

    return gradient
end

