-- أدوات مساعدة عامة (متاحة لكل الحزم)
local API = {}

function API.GetChar()
	return Player.Character
end

function API.GetHum()
	local c = Player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

function API.GetHRP()
	local c = Player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

function API.GetBuildsFolder()
	if not State.BuildsFolder or not State.BuildsFolder.Parent then
		local f = Workspace:FindFirstChild("NexusLocalBuilds") or Instance.new("Folder")
		f.Name = "NexusLocalBuilds"
		f.Parent = Workspace
		State.BuildsFolder = f
	end
	return State.BuildsFolder
end

function API.GetWeatherFolder()
	if not State.WeatherFolder or not State.WeatherFolder.Parent then
		local f = Workspace:FindFirstChild("NexusLocalWeather") or Instance.new("Folder")
		f.Name = "NexusLocalWeather"
		f.Parent = Workspace
		State.WeatherFolder = f
	end
	return State.WeatherFolder
end

function API.PlaySound(id: string, volume: number?, pitch: number?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.45
	s.PlaybackSpeed = pitch or 1
	s.Parent = PlayerGui
	s:Play()
	Debris:AddItem(s, 4)
end

function API.Notify(msg: string, isErr: boolean?)
	if UI.StatusLabel then
		UI.StatusLabel.Text = (isErr and "✖ " or "✔ ") .. msg
		UI.StatusLabel.TextColor3 = isErr and Theme.Danger or Theme.Success
	end
	if isErr then
		API.PlaySound("rbxassetid://6518811702", 0.35, 0.85)
	else
		API.PlaySound("rbxassetid://6026984224", 0.35, 1.1)
	end
end

function API.Register(cmd)
	if not CategoryLookup[cmd.Category] then
		CategoryLookup[cmd.Category] = true
		table.insert(CategoryList, cmd.Category)
	end
	table.insert(Commands, cmd)
end

-- تنظيف المؤثرات على الإضاءة
function API.ClearLightingEffects()
	for _, v in ipairs(Lighting:GetChildren()) do
		if v.Name == "NexusLightingFX" then
			v:Destroy()
		end
	end
end

